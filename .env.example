# انسخ هذا الملف إلى .env ثم املأ القيم.
# ملف .env لا يُرفع إلى GitHub ولا يُشارك مع أحد.

# مطلوب: رمز وصول GitHub (Fine-grained أو Classic) بصلاحية إنشاء مستودع ورفع الملفات وتفعيل Pages.
# للحصول عليه: GitHub > Settings > Developer settings > Personal access tokens
GITHUB_TOKEN=

# اختياري: اسم حساب GitHub أو المؤسسة. إن تُرك فارغًا يُستخدم صاحب الرمز.
GITHUB_OWNER=

# اسم المستودع الذي سيُنشأ أو يُحدَّث
GITHUB_REPO=manara-halaqa

# public أو private (GitHub Pages للمستودعات الخاصة يتطلب خطة مدفوعة)
GITHUB_VISIBILITY=public

# اختياري: الفرع. إن تُرك فارغًا يُستخدم الفرع الافتراضي للمستودع.
GITHUB_BRANCH=
